# Copy to .env (git-ignored) and fill in at least one key. Used by docker compose and by the backend
# when run locally (it reads .env from backend/ or the repo root). No key = Muneem is off.
#
# Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=

# Optional: change the models if a free model is retired.
# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=openai/gpt-oss-120b
