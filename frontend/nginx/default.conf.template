server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # CSV uploads are up to 2 MB (backend limit); nginx's default is 1 MB.
    client_max_body_size 3m;

    # nginx's mime.types has no entry for the sample CSV.
    location = /expenses.csv {
        default_type text/csv;
        types { }
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        # $http_host keeps the port (e.g. localhost:5173). With $host Spring would see a different
        # host:port than the browser's Origin, treat same-origin POSTs as CORS and reject them (403).
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Muneem's chat waits for the AI (several tool rounds, maybe a Groq fallback); default is 60 s.
        proxy_read_timeout 120s;
    }

    # Hashed build files can be cached for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: unknown paths (/expenses, /rules, ...) load index.html.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
